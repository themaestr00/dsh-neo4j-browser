{
  "name": "@local/neo4j-browser",
  "version": "1.5.1",
  "private": true,
  "repository": { "type": "git", "url": "git+ssh://git@github.com/themaestr00/dsh-neo4j-browser.git" },
  "homepage": "https://github.com/themaestr00/dsh-neo4j-browser#readme",
  "bugs": { "url": "https://github.com/themaestr00/dsh-neo4j-browser/issues" },
  "type": "module",
  "description": "Neo4j graph browser with schema-aware Cypher generation",
  "icon": "./assets/icon.svg",
  "exports": { ".": "./src/index.js", "./client": "./src/client.js", "./package.json": "./package.json", "./locale/*.json": "./locale/*.json" },
  "files": ["src", "assets", "cordis.patch.yml", "locale", "README.md"],
  "scripts": {
    "check": "node --check src/index.js && node --check src/backend.js && node --check src/client.js",
    "test": "node --test test/*.test.js"
  },
  "dependencies": { "neo4j-driver": "^5.28.1" },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": { "platform": "web", "immediately": true, "inject": ["@deepseek-ai/dsh-client-ui-conversation"] }
  }
}
